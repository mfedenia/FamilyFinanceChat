# ── liveavatar (two-avatar spoken client) ────────────────────────────────────
# APPEND this block to FamilyFinanceChat's main .env (the repo root), then
# replace every REPLACE_ME. liveavatar reads that file directly; it reuses FFC's
# own OPENAI_API_KEY, so that key is not repeated here.
#   cat liveavatar/.env.example >> .env && chmod 600 .env
# Standalone (outside FFC): copy this to liveavatar/.env and add OPENAI_API_KEY
# if you use GPT-Live.
#
# The main .env is also the open-webui container's env_file, so Open WebUI sees
# these variables too. That is why the Gemini key and port use LIVEAVATAR_
# names: Open WebUI itself reads GEMINI_API_KEY and PORT. Do not add plain
# GEMINI_API_KEY or PORT for liveavatar.

# LiveAvatar — https://app.liveavatar.com/developers (each duo call = TWO billable sessions)
LIVEAVATAR_API_KEY=REPLACE_ME
# Gemini — https://aistudio.google.com/apikey: the duo's listener and router,
# and the personas' voices when DUO_PERSONA_ENGINE=gemini.
LIVEAVATAR_GEMINI_API_KEY=REPLACE_ME

# FFC's Open WebUI: Tony and Antonella are model presets (Workspace → Models).
# Each preset's system prompt is the persona; its attached knowledge base is
# searched every turn. Same names as tools/kb_sync and grading_feature.
# Base URL, e.g. https://case.fedenia.us, or http://localhost:3000 for the test stack.
OPENWEBUI_BASE_URL=REPLACE_ME
# The presets' OWNER's or an ADMIN's key — Open WebUI 0.11.x hides a preset's
# system prompt from read-only users. Settings → Account → API keys (SETUP.md §7).
OPENWEBUI_API_KEY=REPLACE_ME
# The two presets' model ids (shown when editing the model in Workspace → Models).
DUO_OPENWEBUI_MODEL_TONY=REPLACE_ME
DUO_OPENWEBUI_MODEL_ANTONELLA=REPLACE_ME

# Options (defaults shown):
# DUO_SCENARIO=beckham              # beckham (Open WebUI presets) | beckham-local (no Open WebUI) | cohosts
# DUO_PERSONA_ENGINE=gemini         # gemini (Gemini Live) | gptlive (OpenAI GPT-Live — untested; uses FFC's OPENAI_API_KEY)
# DUO_GPT_LIVE_MODEL=gpt-live-1.1
# GEMINI_LIVE_MODEL=gemini-3.8-live
# DUO_VOICE_TONY=Charon             # per-persona voice override: DUO_VOICE_<PERSONA_ID>
# DUO_AVATAR_IDS=id1,id2            # override the scenario's avatars
# DUO_SILENCE_MS=600                # listener end-of-turn silence (<500 never closed a turn)
# DUO_LISTENER_MODEL=gemini-3.5-transcribe-live
# DUO_DECISION_MODEL=gemini-decision-1
# GEMINI_LIVE_DEBUG=1 / GPT_LIVE_DEBUG=1   # log every line sent to the personas
# LIVEAVATAR_PORT=8787              # liveavatar's server port (NOT plain PORT — Open WebUI reads it)
# LIVEAVATAR_API_URL=https://api.liveavatar.com
#
# Single-avatar page (/) only:
# LIVE_PROVIDER=gptlive             # gptlive (OpenAI) | gemini
# GPT_LIVE_MODEL=gpt-live-1
# GPT_LIVE_VOICE=marin
# GPT_LIVE_RESPONSES_MODEL=gpt-5.4-nano
# GEMINI_LIVE_VOICE=Kore
# LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0
