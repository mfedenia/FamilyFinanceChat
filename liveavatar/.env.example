# Copy to .env at the repo root (or run `pnpm run setup`). The server reads
# this file; the browser never sees any of it.

# LiveAvatar API key — https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# ── Duo: two avatars, Gemini (/duo.html) ─────────────────────────────────────
# Gemini-only whatever LIVE_PROVIDER says. Each call runs TWO billable
# LiveAvatar sessions. Scenarios are folders in server/scenarios/ (persona
# prompts, avatars, voices, routing, and knowledge both personas get in full).
GEMINI_API_KEY=
# DUO_SCENARIO=beckham              # beckham (FIN 602 case) | cohosts (two random avatars)
# DUO_AVATAR_IDS=id1,id2            # override the scenario's avatars
# DUO_VOICE_TONY=Charon             # override a persona's voice: DUO_VOICE_<PERSONA_ID>
# DUO_SILENCE_MS=600                # listener end-of-turn silence (<500 never closed a turn)
# DUO_LISTENER_MODEL=gemini-3.5-transcribe-live
# DUO_DECISION_MODEL=gemini-decision-1
# GEMINI_LIVE_MODEL=gemini-3.8-live # the personas' voice model
# GEMINI_LIVE_DEBUG=1               # log every line sent to the personas

# ── Single avatar (/) ─────────────────────────────────────────────────────────
# Which live model drives it: gptlive (OpenAI, default) or gemini.
# LIVE_PROVIDER=gptlive
# OpenAI API key — needed when LIVE_PROVIDER=gptlive (GPT-Live is generally available).
OPENAI_API_KEY=
# GPT_LIVE_MODEL=gpt-live-1
# GPT_LIVE_VOICE=marin              # marin cedar alloy ash ballad coral echo sage shimmer verse
# GPT_LIVE_RESPONSES_MODEL=gpt-5.4-nano  # backend model for delegated turns + tool calls
# GPT_LIVE_DEBUG=1                  # log every GPT-Live event (audio elided)
# GEMINI_LIVE_VOICE=Kore            # voice when LIVE_PROVIDER=gemini
# The persona lives in server/prompts/{instructions,greeting}.md.
# The avatar: unset picks the first active public avatar (and logs which).
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0

# ── Both ──────────────────────────────────────────────────────────────────────
# LIVEAVATAR_API_URL=https://api.liveavatar.com
# PORT=8787
