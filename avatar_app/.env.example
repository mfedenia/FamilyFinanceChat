# Copy to avatar_app/.env (gitignored — never commit it). The server reads this
# file; the browser never sees any of it. In docker compose (AV6) these come
# from the stack's own .env instead.

# LiveAvatar API key — https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# OpenAI API key. GPT-Live is generally available.
OPENAI_API_KEY=
# GPT_LIVE_MODEL=gpt-live-1

# The default avatar. Swap for any avatar id from your account — or unset it
# and the server picks the first active public avatar (and logs which).
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0

# ── Optional (defaults shown) ────────────────────────────────────────────────
#
# GPT_LIVE_VOICE=marin              # default voice; a persona may set its own
#                                   # marin cedar alloy ash ballad coral echo sage shimmer verse
# GPT_LIVE_RESPONSES_MODEL=gpt-5.4-nano  # backend model for delegated turns
# GPT_LIVE_DEBUG=1                  # log every GPT-Live event (audio elided) — loud, for debugging
# LIVEAVATAR_API_URL=https://api.liveavatar.com
# PORT=8787

# ── Guardrails (AV5a) ────────────────────────────────────────────────────────
# AVATAR_ENABLED=true               # kill switch: false refuses every new session
# AVATAR_MAX_SESSION_MIN=15         # hard cap per session; the client wraps up ~1 min before
# AVATAR_METRICS_PORT=9464          # Prometheus /metrics on its own internal port; 0 disables

# ── Personas (AV2) ───────────────────────────────────────────────────────────
# AVATAR_PERSONA_SOURCE=file        # file = avatar_app/personas/*.md
#                                   # openwebui = Open WebUI models tagged AVATAR_PERSONA_TAG
# AVATAR_PERSONA_DIR=               # default: avatar_app/personas
# AVATAR_PERSONA_TAG=avatar
#
# Needed only when AVATAR_PERSONA_SOURCE=openwebui. Same names the grading
# service uses. The key must belong to an ADMIN: Open WebUI hides a model's
# system prompt from everyone else.
# OPENWEBUI_BASE_URL=http://open-webui:8080
# OPENWEBUI_API_KEY=
