# Copy to .env and fill in your own values. Never commit the real key.
#   cp .env.example .env

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults to https://api.openai.com/v1 — set it only if you are
# pointing at an OpenAI-compatible endpoint from another provider.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Set to 1 to score with a deterministic stub instead of calling the
# API — useful for UI work and for tests that should not spend money.
# MOCK_SCORER=1

PORT=8787
