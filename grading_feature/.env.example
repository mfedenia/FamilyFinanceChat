# Under Docker (the `grading` service), compose overrides DATA_PATH, OUTPUT_PATH and
# OPENWEBUI_BASE_URL; only the secrets below need setting on the VM.
DATA_PATH=/path/to/output/json
OUTPUT_PATH=/path/to/output/json
ENV=dev
OPENWEBUI_BASE_URL=http://localhost:8080
OPENWEBUI_USERS_PATH=/api/v1/users/all
OPENWEBUI_CHATS_PATH=/api/v1/chats/all/db
# Auth — provide at least one of these:
# OPENWEBUI_API_KEY=your_api_key_here
# OPENWEBUI_BEARER_TOKEN=your_jwt_token_here
# OPENWEBUI_TIMEOUT_SEC=30
# Scoring (server-side only; never sent to the browser):
# OPENAI_API_KEY=your_openai_key_here
