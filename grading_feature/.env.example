DATA_PATH=/path/to/json
OUTPUT_PATH=/path/to/output
ENV=dev
# DB_PATH=/path/to/db (if present)

# Student feedback rollout controls
STUDENT_FEEDBACK_ENABLED=true

# Required in production for signed handoff from OpenWebUI.
# Token format expected by backend:
# token = base64url(json({"user_id": "...", "exp": <unix_ts_optional>})) + "." + HMAC_SHA256_HEX(payload, OPENWEBUI_HMAC_SECRET)
OPENWEBUI_HMAC_SECRET=replace_with_a_strong_secret

# For local testing only. Set true to allow user ID fallback without signed token.
ALLOW_INSECURE_STUDENT_ID=false
