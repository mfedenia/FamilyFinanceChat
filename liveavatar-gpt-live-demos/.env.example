# Copy to .env at the repo root. The server reads this file; the browser never
# sees any of it.

# LiveAvatar API key — https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# OpenAI API key. GPT-Live is generally available.
OPENAI_API_KEY=
# GPT_LIVE_MODEL=gpt-live-1.1

# The default avatar. Swap for any avatar id from your account — or unset it
# and the server picks the first active public avatar (and logs which).
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0

# ── Optional (defaults shown) ────────────────────────────────────────────────
# The persona lives in server/prompts/{instructions,greeting}.md — edit those
# files to change who the avatar is and how it opens.
#
# GPT_LIVE_VOICE=marin              # marin cedar alloy ash ballad coral echo sage shimmer verse
# GPT_LIVE_RESPONSES_MODEL=gpt-5.4-nano  # backend model for delegated turns + tool calls
# GPT_LIVE_DEBUG=1                  # log every GPT-Live event (audio elided) — loud, for debugging
# LIVEAVATAR_API_URL=https://api.liveavatar.com
# PORT=8787

# ── "Talk to the avatar" button in Open WebUI (pnpm openwebui:setup) ─────────
# OPENWEBUI_BASE_URL=http://localhost:3000
# OPENWEBUI_API_KEY=                 # an admin's key, or OPENWEBUI_EMAIL + OPENWEBUI_PASSWORD
# OPENWEBUI_EMAIL=
# OPENWEBUI_PASSWORD=
# OPENWEBUI_BASE_MODEL=gpt-5.4-mini
# AVATAR_APP_URL=http://localhost:5173

# ── Couple meeting: personas, knowledge and saving to Open WebUI ─────────────
# Personas + knowledge come from these presets (all four set, or none):
# COUPLE_OPENWEBUI_MODEL_TONY=
# COUPLE_OPENWEBUI_MODEL_ANTONELLA=
# OPENWEBUI_KNOWLEDGE_MAX_CHARS=32000   # preset knowledge per spouse in the instructions
# OPENWEBUI_RETRIEVAL_TIMEOUT_MS=4000   # Open WebUI search on a delegated turn
# COUPLE_OPENWEBUI_FAMILY_MODEL=family-beckham  # saved meetings are filed under this preset
# OPENWEBUI_STUDENT_TOKEN=              # testing only: save meetings under this student
# GPT_LIVE_ACK_DELAY_MS=                # 0–800 ms before the spoken "hmm" (API default 0)
